# Обязательный: ключ Gemini API из https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Настоятельно рекомендуется: пароль для доступа к вашему прокси.
# Его же вы вводите в DeepSeek Harness как API-ключ.
PROXY_TOKEN=

# Необязательно: модель по умолчанию для id "gemini-in-russia"
DEFAULT_MODEL=gemini-3.1-flash-lite

# Необязательно: адрес Gemini API (менять не нужно)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
